# Copiar para .env e ajustar. Nao versionar o .env.

APP_NAME="E+Luck API"
DEBUG=true

DATABASE_URL="sqlite:///./eplusluck.db"

# Trocar em qualquer ambiente que nao seja local.
JWT_SECRET="dev-secret-change-me"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=43200

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

STARTING_BALANCE=10000.00
HOUSE_EDGE=0.01
MIN_CHANCE=2.00
MAX_CHANCE=98.00
MIN_BET=0.10
MAX_BET=10000.00
